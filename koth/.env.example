# ---- Solana ----
# Mainnet only. Either a full URL ({key} is substituted) or just a key (assumed Helius).
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_KEY=
BIRDEYE_API_KEY=
# The operator wallet: DBC pool creator (so the master token's metadata update authority) and the
# wallet that runs the entry flow. Any ONE of these forms:
#   KOTH_KEYPAIR=4vJ9...                 bs58 secret key (Phantom / Solflare export)
#   KOTH_KEYPAIR=[12,34,...]             the JSON byte array solana-keygen writes
#   KOTH_KEYPAIR=./keys/operator.json    a path to that file
KOTH_KEYPAIR=

# ---- Master shill token (filled in by `npm run launch-master`) ----
KOTH_DBC_CONFIG=
KOTH_MASTER_MINT=
KOTH_MASTER_POOL=
KOTH_QUOTE_MINT=EVULoNF4DeMBN4dGiZiDfpiiTfNZgoCvXWWgaV3epump   # the curve is quoted in $TOKEN; bonds at 100M

# ---- Game ----
KOTH_DATA_DIR=./data
KOTH_PUBLIC_URL=https://example.com/koth        # where hosted metadata JSON is served from
KOTH_ENTRY_SOL=0.05                             # base attempt fee, in SOL worth of the deposit token
KOTH_ENTRY_GROWTH_PCT=1                         # +1% per successful takeover
KOTH_MODEL=openzoo/auto                          # let the zoo route; or name an OpenRouter-style model id

# ---- openzoo: ALL inference goes through the zoo (run `npx openzoo` for the local x402-paying proxy) ----
OPENZOO_BASE_URL=http://localhost:8402/v1
OPENZOO_API_KEY=sk-openzoo                      # any value: the zoo takes payment, not keys
OPENZOO_CONTEXT=                                # optional leCore context id (X-HRR-Context)
OPENZOO_WALLET_ADDRESS=                         # the burner that pays x402; default reads ~/.openzoo/wallet.json
KOTH_INFERENCE_PAY=TOKEN                        # TOKEN | LEOS | USDC: what the inference share is converted into
JUPITER_API_KEY=                                # recommended: swaps go through Jupiter Ultra (routes into the master's DBC curve); keyless lite-api otherwise
PINATA_JWT=                                     # optional: pin king JSON to IPFS instead of serving it from KOTH_PUBLIC_URL

# ---- Play program (Pinocchio LP vault) ----
KOTH_PLAY_PROGRAM_ID=
RAYDIUM_CPMM_PROGRAM_ID=CPMMoo8L3F4NbTegBCKVNunggL7H1ZpdTHKxQB5qKP1C

# ---- Surfaces ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
# X mirrors Telegram: mentions are commands, long replies thread, cards ride as native media (PNG).
# OAuth 1.0a user keys from the developer portal (app with Read+Write, "user authentication" on).
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_BEARER_TOKEN=                                 # optional: app bearer for reading mentions (else the user keys read them)
X_BOT_USER_ID=                                  # optional: learned from /2/users/me on start
X_MAX_CHARS=4000                                # the Premium limit; 280 on a plain account (long replies thread either way)
X_POLL_SECONDS=90                               # mention poll interval; 429s are honoured whatever this says
X_RAW_ADDRESSES=0                               # 0: addresses in posts are written in groups of five (X refuses unbroken ones for an app's first 7 days) + a link to /q/<id> or /king with copy buttons; 1: unbroken
